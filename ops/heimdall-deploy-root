#!/usr/bin/env bash
set -euo pipefail

CONF=/etc/heimdall/deploy.conf
if [[ ! -r "$CONF" ]]; then
  echo "Heimdall deploy config missing: $CONF" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CONF"

: "${REPO_ROOT:?REPO_ROOT missing}"
: "${DEPLOY_USER:?DEPLOY_USER missing}"

if [[ ! -d "$REPO_ROOT/.git" ]]; then
  echo "Not a Heimdall git checkout: $REPO_ROOT" >&2
  exit 1
fi

mkdir -p /var/lib/heimdall /etc/heimdall
chown "$DEPLOY_USER":"$DEPLOY_USER" /var/lib/heimdall
chmod 0755 /var/lib/heimdall

# Install Heimdall convenience/status tools.
if [[ -f "$REPO_ROOT/scripts/heimdall-status" ]]; then
  install -o root -g root -m 0755 \
    "$REPO_ROOT/scripts/heimdall-status" \
    /usr/local/bin/heimdall-status
fi

# When a Pwnagotchi-compatible runtime exists, use its native UI/display stack.
# Josh's Waveshare V2 is already supported as ui.display.type = "waveshare_2".
# Heimdall extends the runtime through plugins and UI/voice overlays instead of
# running a second GPIO owner for the same e-paper panel.
PWN_RUNTIME=0
if systemctl list-unit-files pwnagotchi.service >/dev/null 2>&1 || \
   python3 -c 'import pwnagotchi' >/dev/null 2>&1; then
  PWN_RUNTIME=1
fi

if [[ "$PWN_RUNTIME" -eq 1 ]]; then
  PLUGIN_DIR=/usr/local/share/pwnagotchi/custom-plugins
  mkdir -p "$PLUGIN_DIR"

  for plugin in \
    heimdall_heartbeat.py \
    heimdall_health.py \
    heimdall_mode.py \
    heimdall_telemetry.py; do
    if [[ -f "$REPO_ROOT/custom_plugins/$plugin" ]]; then
      install -o root -g root -m 0644 \
        "$REPO_ROOT/custom_plugins/$plugin" \
        "$PLUGIN_DIR/$plugin"
    fi
  done

  # The standalone display service is a development fallback only. Disable it
  # once the native Pwnagotchi display stack is available to avoid GPIO17/SPI
  # contention between two e-paper drivers.
  systemctl disable --now heimdall-display.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/heimdall-display.service
else
  # Development fallback for a clean Raspberry Pi OS host before the inherited
  # Pwnagotchi runtime is installed.
  if [[ -f "$REPO_ROOT/systemd/heimdall-display.service" ]]; then
    install -o root -g root -m 0644 \
      "$REPO_ROOT/systemd/heimdall-display.service" \
      /etc/systemd/system/heimdall-display.service
  fi
fi

VERSION="unknown"
[[ -r "$REPO_ROOT/VERSION" ]] && VERSION="$(tr -d '\r\n' < "$REPO_ROOT/VERSION")"
BUILD="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
cat > /etc/heimdall/release <<EOF
NAME=Heimdall
NODE=OVN-002
PERSONA=Josh
VERSION=$VERSION
BUILD=$BUILD
BRANCH=$(git -C "$REPO_ROOT" branch --show-current 2>/dev/null || echo unknown)
PWN_RUNTIME=$PWN_RUNTIME
EOF
chmod 0644 /etc/heimdall/release

systemctl daemon-reload

if [[ "$PWN_RUNTIME" -eq 1 ]]; then
  systemctl restart pwnagotchi.service >/dev/null 2>&1 || true
else
  if systemctl list-unit-files heimdall-display.service >/dev/null 2>&1; then
    systemctl enable heimdall-display.service >/dev/null 2>&1 || true
    systemctl restart heimdall-display.service || true
  fi
fi

echo "Heimdall deploy complete: v$VERSION build $BUILD (pwn runtime: $PWN_RUNTIME)"
