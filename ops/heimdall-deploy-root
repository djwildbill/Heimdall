#!/usr/bin/env bash
set -euo pipefail

CONF=/etc/heimdall/deploy.conf
if [[ ! -r "$CONF" ]]; then
  echo "Heimdall deploy config missing: $CONF" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CONF"

: "${REPO_ROOT:?REPO_ROOT missing}"
: "${DEPLOY_USER:?DEPLOY_USER missing}"

if [[ ! -d "$REPO_ROOT/.git" ]]; then
  echo "Not a Heimdall git checkout: $REPO_ROOT" >&2
  exit 1
fi

BASE="$REPO_ROOT/project_heimdall"
mkdir -p /var/lib/heimdall /etc/heimdall
chown "$DEPLOY_USER":"$DEPLOY_USER" /var/lib/heimdall
chmod 0755 /var/lib/heimdall

# Refresh the appliance control plane every deployment. This is what makes a
# one-time SSH bootstrap turn into reliable future Web/Bluetooth updates.
for unit in heimdall.service heimdall-maintenance.service heimdall-ui.service heimdall-radio.service heimdall-recovery.service heimdall-bluetooth.service; do
  [[ -f "$BASE/systemd/$unit" ]] || continue
  install -o root -g root -m 0644 "$BASE/systemd/$unit" "/etc/systemd/system/$unit"
done
[[ -f "$BASE/maintenance_helper.sh" ]] && install -o root -g root -m 0755 "$BASE/maintenance_helper.sh" /usr/local/sbin/heimdall-maintenance
[[ -f "$BASE/recovery_helper.sh" ]] && install -o root -g root -m 0755 "$BASE/recovery_helper.sh" /usr/local/sbin/heimdall-recovery
[[ -f "$BASE/radio_helper.sh" ]] && install -o root -g root -m 0755 "$BASE/radio_helper.sh" /usr/local/sbin/heimdall-radio-control

for tool in "$REPO_ROOT"/scripts/heimdall-* "$REPO_ROOT"/scripts/bifrost-*; do
  [[ -f "$tool" ]] || continue
  install -o root -g root -m 0755 "$tool" "/usr/local/bin/$(basename "$tool")"
done

# A Python pwnagotchi package existing on disk does NOT mean a native
# pwnagotchi daemon owns the display. Only use native Pwnagotchi presentation
# when a real systemd unit exists; otherwise Heimdall owns the Waveshare panel.
PWN_RUNTIME=0
PKG_DIR=""
if systemctl cat pwnagotchi.service >/dev/null 2>&1; then
  PWN_RUNTIME=1
  if python3 -c 'import pwnagotchi' >/dev/null 2>&1; then
    PKG_DIR="$(python3 - <<'PY'
import os, pwnagotchi
print(os.path.dirname(os.path.abspath(pwnagotchi.__file__)))
PY
)"
  fi
fi

if [[ "$PWN_RUNTIME" -eq 1 ]]; then
  PLUGIN_DIR=/usr/local/share/pwnagotchi/custom-plugins
  mkdir -p "$PLUGIN_DIR"

  for plugin in "$REPO_ROOT"/custom_plugins/heimdall_*.py; do
    [[ -f "$plugin" ]] || continue
    base="$(basename "$plugin")"
    install -o root -g root -m 0644 "$plugin" "$PLUGIN_DIR/$base"
    alias_name="${base//_/-}"
    install -o root -g root -m 0644 "$plugin" "$PLUGIN_DIR/$alias_name"
  done

  PWN_CONFIG=/etc/pwnagotchi/config.toml
  if [[ -f "$PWN_CONFIG" ]] && ! grep -q '^main\.plugins\.heimdall-display\.enabled' "$PWN_CONFIG"; then
    cat >> "$PWN_CONFIG" <<'EOF'

# Project Odin / Heimdall live e-paper dashboard
main.plugins.heimdall-display.enabled = true
main.plugins.heimdall-display.state_path = "/var/lib/heimdall/wireless.json"
main.plugins.heimdall-display.health_path = "/var/lib/heimdall/health.json"
main.plugins.heimdall-display.refresh_seconds = 5
EOF
  fi

  if [[ -f "$PWN_CONFIG" ]] && ! grep -q '^main\.plugins\.heimdall-telemetry\.enabled' "$PWN_CONFIG"; then
    cat >> "$PWN_CONFIG" <<'EOF'

# Project Odin / Heimdall wireless telemetry
main.plugins.heimdall-telemetry.enabled = true
main.plugins.heimdall-telemetry.state_path = "/var/lib/heimdall/wireless.json"
EOF
  fi

  if [[ -n "$PKG_DIR" && -d "$PKG_DIR" ]]; then
    mkdir -p /var/backups/heimdall/ui
    for rel in voice.py ui/faces.py ui/view.py; do
      src="$REPO_ROOT/pwnagotchi/$rel"
      dst="$PKG_DIR/$rel"
      if [[ -f "$src" && -f "$dst" ]]; then
        if [[ "$(readlink -f "$src")" == "$(readlink -f "$dst")" ]]; then
          echo "Pwnagotchi overlay already active: $rel"
          continue
        fi
        [[ -f "/var/backups/heimdall/ui/$(basename "$rel").original" ]] || \
          cp -a "$dst" "/var/backups/heimdall/ui/$(basename "$rel").original"
        install -o root -g root -m 0644 "$src" "$dst"
      fi
    done
  fi

  systemctl disable --now heimdall-display.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/heimdall-display.service
else
  if [[ -f "$REPO_ROOT/systemd/heimdall-display.service" ]]; then
    install -o root -g root -m 0644 "$REPO_ROOT/systemd/heimdall-display.service" /etc/systemd/system/heimdall-display.service
  else
    echo "Missing dedicated Heimdall display unit" >&2
    exit 1
  fi
fi

if [[ -f "$REPO_ROOT/systemd/heimdall-bifrost-postboot.service" ]]; then
  install -o root -g root -m 0644 "$REPO_ROOT/systemd/heimdall-bifrost-postboot.service" /etc/systemd/system/heimdall-bifrost-postboot.service
fi

VERSION="unknown"
[[ -r "$REPO_ROOT/VERSION" ]] && VERSION="$(tr -d '\r\n' < "$REPO_ROOT/VERSION")"
BUILD="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
cat > /etc/heimdall/release <<EOF
NAME=Heimdall
NODE=OVN-002
PERSONA=Josh
VERSION=$VERSION
BUILD=$BUILD
BRANCH=$(git -C "$REPO_ROOT" branch --show-current 2>/dev/null || echo unknown)
PWN_RUNTIME=$PWN_RUNTIME
EOF
chmod 0644 /etc/heimdall/release

systemctl daemon-reload
systemctl enable heimdall.service heimdall-maintenance.service heimdall-ui.service heimdall-radio.service heimdall-recovery.service heimdall-bluetooth.service >/dev/null 2>&1 || true
systemctl enable heimdall-bifrost-postboot.service >/dev/null 2>&1 || true

if [[ "$PWN_RUNTIME" -eq 1 ]]; then
  systemctl restart pwnagotchi.service
else
  systemctl enable heimdall-display.service >/dev/null 2>&1
  systemctl restart heimdall-display.service
fi

# Restart control services after files/helpers are in place. Bluetooth and Web
# requests intentionally reconnect after a managed update.
systemctl restart heimdall.service || true
systemctl restart heimdall-radio.service || true
systemctl restart heimdall-recovery.service || true
systemctl restart heimdall-ui.service || true
systemctl restart heimdall-bluetooth.service || true
systemctl restart heimdall-maintenance.service || true

echo "Heimdall deploy complete: v$VERSION build $BUILD (pwn runtime: $PWN_RUNTIME)"
echo "display=$(systemctl is-active heimdall-display.service 2>/dev/null || true)"
echo "bluetooth=$(systemctl is-active heimdall-bluetooth.service 2>/dev/null || true)"
echo "maintenance=$(systemctl is-active heimdall-maintenance.service 2>/dev/null || true)"
