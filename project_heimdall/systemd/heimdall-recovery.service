[Unit]
Description=Project Odin Heimdall Josh Recovery Portal
After=network-online.target heimdall-maintenance.service
Requires=heimdall-maintenance.service

[Service]
Type=simple
User=nabzaf
WorkingDirectory=/home/nabzaf/Heimdall/project_heimdall
ExecStart=/home/nabzaf/Heimdall/project_heimdall/.venv/bin/python /home/nabzaf/Heimdall/project_heimdall/recovery_portal.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
