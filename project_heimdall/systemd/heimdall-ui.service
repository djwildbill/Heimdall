[Unit]
Description=Project Odin Heimdall Control Center UI
After=heimdall.service network-online.target
Requires=heimdall.service

[Service]
Type=simple
User=nabzaf
WorkingDirectory=/home/nabzaf/Heimdall/project_heimdall
ExecStart=/home/nabzaf/Heimdall/project_heimdall/.venv/bin/python /home/nabzaf/Heimdall/project_heimdall/ui_control.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
